; COMO USAR:
; 1) Abra a cena para acessar o menu principal.
; 2) New Game cria campanha e abre o Map Screen.
; 3) Load/Options ficam nos painéis abaixo.
[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id=1]

[node name="MainMenu" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource(1)

[node name="MainLayout" type="VBoxContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220
offset_top = -220
offset_right = 220
offset_bottom = 220
alignment = 1

[node name="Title" type="Label" parent="MainLayout"]
text = "Cortex Tactics"
horizontal_alignment = 1

[node name="ButtonContainer" type="VBoxContainer" parent="MainLayout"]

[node name="NewGameButton" type="Button" parent="MainLayout/ButtonContainer"]
text = "New Game"

[node name="LoadGameButton" type="Button" parent="MainLayout/ButtonContainer"]
text = "Load Game"

[node name="OptionsButton" type="Button" parent="MainLayout/ButtonContainer"]
text = "Options"

[node name="LegacyButton" type="Button" parent="MainLayout/ButtonContainer"]
text = "MVP Mode (Legacy Hub)"

[node name="QuitButton" type="Button" parent="MainLayout/ButtonContainer"]
text = "Quit"

[node name="LoadPanel" type="Panel" parent="MainLayout"]
visible = false
custom_minimum_size = Vector2(0, 160)

[node name="LoadList" type="VBoxContainer" parent="MainLayout/LoadPanel"]
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12
offset_top = 12
offset_right = -12
offset_bottom = -48

[node name="LoadBackButton" type="Button" parent="MainLayout/LoadPanel"]
anchor_left = 0.5
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -60
offset_top = -36
offset_right = 60
offset_bottom = -6
text = "Voltar"

[node name="OptionsPanel" type="Panel" parent="MainLayout"]
visible = false
custom_minimum_size = Vector2(0, 200)

[node name="OptionsList" type="VBoxContainer" parent="MainLayout/OptionsPanel"]
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12
offset_top = 12
offset_right = -12
offset_bottom = -48

[node name="FullscreenCheck" type="CheckBox" parent="MainLayout/OptionsPanel/OptionsList"]
text = "Fullscreen"

[node name="VolumeSlider" type="HSlider" parent="MainLayout/OptionsPanel/OptionsList"]
min_value = 0.0
max_value = 1.0
step = 0.05
value = 1.0

[node name="SensitivitySlider" type="HSlider" parent="MainLayout/OptionsPanel/OptionsList"]
min_value = 0.1
max_value = 1.0
step = 0.05
value = 0.5

[node name="InvertYCheck" type="CheckBox" parent="MainLayout/OptionsPanel/OptionsList"]
text = "Invert Y"

[node name="OptionsBackButton" type="Button" parent="MainLayout/OptionsPanel"]
anchor_left = 0.5
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -60
offset_top = -36
offset_right = 60
offset_bottom = -6
text = "Voltar"
